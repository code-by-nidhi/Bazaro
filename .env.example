# Bazaro Environment Variables Configuration
# Copy this file to server/.env

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bazaro
JWT_SECRET=bazaro_super_secret_jwt_key_2026_production_grade
JWT_EXPIRE=30d

# Cloudinary Storage Setup (Optional - Falls back to Unsplash web images if unconfigured)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Test / Live Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173
NODE_ENV=development
